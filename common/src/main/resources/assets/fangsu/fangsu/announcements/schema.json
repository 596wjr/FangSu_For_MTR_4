{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
        "maxLength": 256
      }
    },
    "voices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "displayName": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "mode": {
            "enum": [
              "preset",
              "reference_audio",
              "recording"
            ]
          },
          "samples": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "resource": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
                  "maxLength": 256
                },
                "text": {
                  "type": "string",
                  "maxLength": 4096
                },
                "chineseNamesResource": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
                  "maxLength": 256
                },
                "chineseNamesText": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "required": [
                "resource"
              ],
              "additionalProperties": false
            }
          },
          "providerHints": {
            "type": "object"
          },
          "presetVoices": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "mimo",
                "minimax-cn",
                "minimax-intl"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 256
            }
          }
        },
        "required": [
          "id",
          "mode"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "reference_audio"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "samples"
              ],
              "properties": {
                "samples": {
                  "minProperties": 1
                }
              }
            }
          }
        ]
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "displayName": {
            "type": "object"
          },
          "event": {
            "enum": [
              "platform.approaching",
              "train.next",
              "train.approaching",
              "train.arrived",
              "train.terminal"
            ]
          },
          "defaultVariant": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]{1,64}$"
                },
                "voice": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
                  "maxLength": 256
                },
                "style": {
                  "type": "string",
                  "maxLength": 1024
                },
                "languageVoices": {
                  "type": "object",
                  "maxProperties": 32,
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "voice"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "voice": {
                        "type": "string",
                        "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
                        "maxLength": 256
                      },
                      "style": {
                        "type": "string",
                        "maxLength": 1024
                      }
                    }
                  }
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "voice"
                  ]
                },
                {
                  "required": [
                    "languageVoices"
                  ],
                  "properties": {
                    "languageVoices": {
                      "minProperties": 1
                    }
                  }
                }
              ]
            }
          },
          "locales": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "segments": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 4096
                      },
                      "when": {
                        "enum": [
                          "",
                          "allStops",
                          "limitedService",
                          "shortTurn",
                          "terminal",
                          "hasInterchanges",
                          "doorSideKnown",
                          "firstStop",
                          "notTerminal",
                          "leftDoors",
                          "rightDoors",
                          "stationSuffixNeeded"
                        ]
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "segments"
              ],
              "additionalProperties": false
            }
          },
          "requiredVariables": {
            "type": "array",
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "enum": [
                "tripDestination",
                "fullServiceDestination",
                "station",
                "nextStation",
                "route",
                "doorSide",
                "interchanges"
              ]
            }
          }
        },
        "required": [
          "id",
          "event",
          "defaultVariant",
          "variants",
          "locales"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
